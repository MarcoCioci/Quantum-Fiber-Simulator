\newlabel{fig:experiment1_validation}{{1}{24}{Numerical and analytical comparison for the correlation observables \(c_{xx}\), \(c_{yy}\), and \(c_{zz}\). The agreement validates the implementation of the reduced phase model}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  State-characterization quantities for the phase-evolved state. Global purity and concurrence remain constant, while fidelity varies with the relative phase \( \theta \). }}{24}{figure.caption.2}\protected@file@percent }
\newlabel{fig:experiment1_state_metrics}{{2}{24}{State-characterization quantities for the phase-evolved state. Global purity and concurrence remain constant, while fidelity varies with the relative phase \( \theta \)}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  Full correlation tensor \(T_{ij}(\theta )\) for the phase-evolved state. The off-diagonal components \(T_{xy}\) and \(T_{yx}\) reveal the rotation of the correlation structure in the transverse plane. }}{24}{figure.caption.3}\protected@file@percent }
\newlabel{fig:experiment1_tensor}{{3}{24}{Full correlation tensor \(T_{ij}(\theta )\) for the phase-evolved state. The off-diagonal components \(T_{xy}\) and \(T_{yx}\) reveal the rotation of the correlation structure in the transverse plane}{figure.caption.3}{}}
